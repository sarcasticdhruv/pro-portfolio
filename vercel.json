{
  "headers": [
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/cv-files/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cv/:file",
      "destination": "/api/cv?f=:file"
    },
    {
      "source": "/c/:file",
      "destination": "/api/cv?f=:file"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
